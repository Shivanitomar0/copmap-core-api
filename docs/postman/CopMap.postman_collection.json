  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Login - Planner (PLN001)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.environment.set('token', res.data.accessToken);",
                  "    pm.environment.set('planner_token', res.data.accessToken);",
                  "}",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has access token', function () { pm.expect(res.data.accessToken).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"badgeNo\": \"PLN001\",\n  \"password\": \"Copmap@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
