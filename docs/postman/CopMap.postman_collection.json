{
  "info": {
    "name": "CopMap API",
    "_postman_id": "c1f7b8d0-copmap-backend-collection",
    "description": "Comprehensive Postman collection for CopMap Backend covering Authentication, Patrols, Assignments, Tracking, Alerts, PDF Reports, and Bandobast stubs.",
